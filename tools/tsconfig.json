{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "node16",
    "target": "ES2021",
    "rootDir": "..",
    "outDir": "../builds/ts-tools",
    "noEmit": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": [
      "node",
      "@types/chrome"
    ],
    "lib": [
      "DOM",
      "ES2021"
    ]
  },
  "include": [
    "./**/*.ts",
    "../playwright.config.ts"
  ],
  "exclude": [
    "../builds/"
  ]
}
