{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ES2022",
    "moduleResolution": "bundler",
    "noEmit": true,
    "types": [
      "@violentmonkey/types",
      "@types/chrome"
    ],
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2020"
    ],
    "outDir": "builds/test/crx/tsOutput",
    "paths": {
      "@fa/*": ["./node_modules/@fortawesome/free-regular-svg-icons/*"],
      "@fas/*": ["./node_modules/@fortawesome/free-solid-svg-icons/*"],
      "@fortawesome/fontawesome-common-types": ["./node_modules/@fortawesome/fontawesome-common-types/index.d.ts"]
    }
  },
  "include": [
    "src/Archive/**/*",
    "src/classes/**/*",
    "src/config/**/*",
    "src/css/**/*",
    "src/Filtering/**/*",
    "src/General/**/*",
    "src/globals/**/*",
    "src/Icons/**/*",
    "src/Images/**/*",
    "src/Linkification/**/*",
    "src/main/**/*",
    "src/Menu/**/*",
    "src/Miscellaneous/**/*",
    "src/Monitoring/**/*",
    "src/PageContext/**/*",
    "src/platform/**/*",
    "src/Posting/**/*",
    "src/Quotelinks/**/*",
    "src/site/**/*",
    "src/types/**/*"
  ],
  "exclude": [
    "builds/",
    "tools/"
  ]
}
