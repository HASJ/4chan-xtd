{
  "compilerOptions": {
    "module": "ES2022",
    "moduleResolution": "bundler",
    "noImplicitAny": false,
    "removeComments": false,
    "sourceMap": true,
    "target": "ES2020",
    "allowJs": false,
    "resolveJsonModule": false,
    "noEmit": true,
    "newLine": "lf",
    "jsx": "react",
    "jsxFactory": "h",
    "jsxFragmentFactory": "hFragment",
    "types": [
      "@violentmonkey/types",
      "@types/chrome"
    ],
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2020"
    ],
    "outDir": "builds/test/crx/tsOutput",
    "importHelpers": true,
    "paths": {
      "@fa/*": ["./node_modules/@fortawesome/free-regular-svg-icons/*"],
      "@fas/*": ["./node_modules/@fortawesome/free-solid-svg-icons/*"],
      "@fortawesome/fontawesome-common-types": ["./node_modules/@fortawesome/fontawesome-common-types/index.d.ts"]
    },
    "skipDefaultLibCheck": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.d.ts"
  ],
  "exclude": [
    "builds/",
    "tools/",
    "src/meta/"
  ]
}